	case strings.Contains(lower, "7900 xtx"):
		return 24576
	case strings.Contains(lower, "7900 xt"):
		return 20480
	case strings.Contains(lower, "7800 xt"):
		return 16384
	case strings.Contains(lower, "7700 xt"):
