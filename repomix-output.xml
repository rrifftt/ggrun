			t.Fatalf("add: %v", err)
		}
	}

	fasterIK := Entry{Timestamp: 4, ModelPath: "/models/test.gguf", HardwareHash: "abc123", Backend: "ik_llama", Result: BenchmarkResult{GenTPS: 55}, Best: true}
	if err := c.Add(fasterIK); err != nil {
