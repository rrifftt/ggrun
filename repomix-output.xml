	}
	got = loadProbeCache(dir, model, 1048576, 64, "high", "gpu", "llama", gpus, 1)
	if got == nil || got.RuntimeGraphGrowthByGPU[2] != 8616 {
		t.Fatalf("schema-2 runtime growth was not preserved: %#v", got)
	}
}

