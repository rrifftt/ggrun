	}

	info := &gguf.Info{BlockCount: 40, ContextLength: 100000}
	got := EstimateFitCtxForInfo("/models/Model-00001-of-00002.gguf", cacheDir, info, 128000)
	if got != 65536 {
		t.Fatalf("fit context = %d, want valid cached 65536", got)
	}
